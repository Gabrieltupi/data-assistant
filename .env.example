# Provider ativo: ollama | google | openai | anthropic
LLM_PROVIDER=ollama

# Ollama (padrão — roda local, sem custo)
OLLAMA_BASE_URL=http://localhost:11434
# 7b = testes mais rápidos (CPU). 14b = melhor SQL, bem mais lento.
OLLAMA_MODEL=qwen2.5-coder:7b

# Google Gemini
# GOOGLE_API_KEY=sua-chave-aqui
# GOOGLE_MODEL=gemini-2.0-flash

# OpenAI (alternativa)
# OPENAI_API_KEY=sua-chave-aqui
# OPENAI_MODEL=gpt-4o-mini

# Anthropic Claude
# ANTHROPIC_API_KEY=sua-chave-aqui
# ANTHROPIC_MODEL=claude-sonnet-4-5

# Banco e limites
SQLITE_PATH=data/anexo_desafio_1.db
SQL_MAX_ROWS=500
SQL_MAX_RETRIES=3
